{
  "name": "fir-project",
  "private": true,
  "version": "1.0.0",
  "description": "AI-powered FIR generation system for Indian Police Departments",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter '@fir/shared' build && pnpm --parallel --filter './apps/*' build",
    "lint": "pnpm --parallel --filter './apps/*' --filter './packages/*' lint",
    "typecheck": "pnpm --parallel --filter './apps/*' --filter './packages/*' typecheck"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "msgpackr-extract"
    ]
  }
}
