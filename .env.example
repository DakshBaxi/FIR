# ============================================================
# FIR Project — Environment Variables
# Copy this to .env and fill in values before running
# ============================================================

# --- PostgreSQL ---
DATABASE_URL="postgresql://fir_user:fir_password@localhost:5432/fir_db"
POSTGRES_USER=fir_user
POSTGRES_PASSWORD=fir_password
POSTGRES_DB=fir_db

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT Secrets (generate with: openssl rand -hex 64) ---
JWT_ACCESS_SECRET=replace_with_64_byte_hex_secret_access
JWT_REFRESH_SECRET=replace_with_64_byte_hex_secret_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Node API ---
NODE_ENV=development
API_PORT=4000
FRONTEND_URL=http://localhost:5173

# --- Python AI Service ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
AI_SERVICE_TIMEOUT_MS=300000

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Security ---
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# --- PDF Storage (local path for archived PDFs) ---
PDF_STORAGE_PATH=./storage/pdfs
